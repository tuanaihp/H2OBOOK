# Runtime: demo | production
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_UNIFIED_INPUT_ENABLED=true

# Supabase Auth + PostgreSQL + RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 / S3-compatible private assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=h2obook
R2_PUBLIC_OR_CDN_URL=
MAX_UPLOAD_BYTES=262144000

# File scanner (generic HTTP endpoint returning {status:"clean"|"blocked"})
FILE_SCAN_URL=http://document-processor:8080/scan
FILE_SCAN_TOKEN=replace-with-strong-shared-secret

# Queue / document worker
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_PASSWORD=change-me
DOCUMENT_WORKER_URL=http://document-processor:8080
DOCUMENT_WORKER_SECRET=replace-with-strong-shared-secret
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_WORKER_TIMEOUT_MS=2700000
DOCUMENT_WORKER_HEARTBEAT_MS=15000
DOCUMENT_WORKER_LOCK_MS=1200000
DOCUMENT_WORKER_STALLED_INTERVAL_MS=30000
DOCUMENT_WORKER_MAX_STALLED=1
DOCUMENT_JOB_ATTEMPTS=3
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=15000
INPUT_RECOVERY_INTERVAL_SECONDS=60
MAX_PROCESSOR_REQUEST_BYTES=4194304
MAX_PROCESSOR_SOURCE_BYTES=314572800
MAX_PROCESSOR_INPUT_KEYS=200
MAX_ZIP_ENTRIES=20000
MAX_ZIP_ENTRY_BYTES=157286400
MAX_ZIP_COMPRESSION_RATIO=100

# Payment adapter: manual | generic provider name
PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=
PAYMENT_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=

# Email: console | webhook | resend
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_WEBHOOK_URL=
EMAIL_FROM=H2OBOOK <noreply@example.com>

# Security / monitoring
CRON_SECRET=
ENCRYPTION_KEY=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# AI Gateway — HOÀN TOÀN TÙY CHỌN
# Để trống hai biến này, H2OBOOK vẫn chạy đầy đủ bằng Smart Core Local.
NEXT_PUBLIC_AI_DEFAULT_ENABLED=false
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=

# Collaboration / realtime
NEXT_PUBLIC_REALTIME_ENABLED=false
COLLABORATION_SIGNING_SECRET=

# White-label / licensing
WHITE_LABEL_ROOT_DOMAIN=
ROYALTY_PAYOUT_WEBHOOK_SECRET=
AUTOMATION_WEBHOOK_ALLOWLIST=

# Enterprise webhooks: 32+ random characters; used to encrypt endpoint secrets at rest.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_WORKER_POLL_MS=2000
WEBHOOK_WORKER_CONCURRENCY=5

# HTML Import 2.0
MAX_HTML_IMPORT_BYTES=5000000

# H2OBOOK 4.14 public academy and student experience
NEXT_PUBLIC_PUBLIC_SITE_V2=true
NEXT_PUBLIC_STUDENT_EXPERIENCE_V2=true

# H2OBOOK 4.15 global neural design system
NEXT_PUBLIC_GLOBAL_NEURAL_DESIGN_V1=true
NEXT_PUBLIC_GLOBAL_NEURAL_MOTION=auto
